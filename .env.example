# Строка подключения к Neon (Postgres)
# Скопируй из Dashboard Neon → Connect → Node.js
DATABASE_URL=postgresql://neondb_owner:твой_пароль@ep-....neon.tech/neondb?sslmode=require

# Пароль для входа в админку (admin.html)
ADMIN_PASSWORD=придумай_сильный_пароль

# Случайная длинная строка для подписи JWT-токенов
# Можно сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=любая_длинная_случайная_строка
